# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment
.env

# Data (too large for git — use Git LFS or share separately)
data/
*.db
*.sqlite
*.csv
*.parquet
*.csv.gz
*.dump

# Models (trained, too large for git)
models/
*.pkl

# API models: baked into the image via api/Dockerfile and seeded into the
# compose volume by scripts/seed_models.sh. These 5 pre-trained model_*.pkl
# (~14.5 MB total) ARE committed so `make demo` works on any fresh clone — in
# particular model_draft.pkl is NOT reproducible from this repo's training code
# (train_all_models.py only regenerates the @5/@10/@15/@20 timeline models), so
# it can only be shipped as a binary. The broad `models/` rule above would
# ignore the whole api/models/ directory (and git won't descend into an ignored
# dir to honor a nested negation), so re-include the directory and the models.
!api/models/
api/models/*
!api/models/.gitkeep
!api/models/model_*.pkl

# DVC pipeline metrics (Phase 2). Tiny JSON files (~200 bytes each) tracked
# with `cache: false` so they live in git, not the DVC cache. Re-include them
# explicitly under the otherwise-ignored `models/` directory so `dvc metrics
# show` and `dvc metrics diff` work against history.
!models/
models/*
!models/.gitkeep
!models/metrics_*.json

# DVC local remote (`dvc remote add -d local-storage .dvc-storage`). Never
# committed: contents are content-addressed copies of DVC-tracked artefacts
# and would explode the repo. Push/pull via `dvc push|pull` instead.
.dvc-storage/

# Docker volumes
pgdata/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Local tool caches & dev-time screenshots (not referenced by any doc)
.playwright-mcp/
prg-*.png
