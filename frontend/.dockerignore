# Dependencies (reinstalled inside the image via `npm ci`)
node_modules

# Build output (regenerated by `npm run build`)
.next
out
build

# Version control / tooling
.git
.gitignore

# Local env files — never bake secrets/overrides into the image
.env
.env*.local

# Editor / OS cruft
.DS_Store
*.pem
*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docs / docker meta (not needed at build/runtime)
README.md
Dockerfile
.dockerignore
.vercel
