# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment
.env

# Data (too large for git — use Git LFS or share separately)
data/
*.db
*.sqlite
*.csv
*.parquet
*.csv.gz
*.dump

# ...but frontend/src/data/ is SOURCE CODE (the champion list the draft UI
# imports), not bulk data — the broad `data/` rule above would wrongly ignore it
# and break a fresh clone's `npm run build`. Re-include the dir and its contents.
!frontend/src/data/
!frontend/src/data/**

# ...and the multi-page Streamlit ships SMALL *sample* parquets (~31 MB) so its
# parquet-backed pages work reproducibly (the full ~1 GB parquets are not bundled).
!streamlit_app/sample_data/
!streamlit_app/sample_data/*.parquet

# Models (trained, too large for git)
models/
*.pkl

# API models: the 5 pre-trained model_*.pkl (~14.5 MB) are DVC-tracked and
# hosted on DagsHub, NOT committed to git. `make demo` pulls them via
# `make fetch-models` (dvc pull) before seeding the compose volume. The .pkl
# binaries stay git-ignored (broad `models/` + `*.pkl` rules above); only the
# DVC pointer files (api/models/*.pkl.dvc) and .gitkeep are committed. The broad
# `models/` rule would ignore the whole api/models/ directory (and git won't
# descend into an ignored dir to honor a nested negation), so re-include the
# directory and the pointers.
!api/models/
api/models/*
!api/models/.gitkeep
!api/models/*.dvc

# DVC pipeline metrics (Phase 2). Tiny JSON files (~200 bytes each) tracked
# with `cache: false` so they live in git, not the DVC cache. Re-include them
# explicitly under the otherwise-ignored `models/` directory so `dvc metrics
# show` and `dvc metrics diff` work against history.
!models/
models/*
!models/.gitkeep
!models/metrics_*.json

# DVC local remote (`dvc remote add -d local-storage .dvc-storage`). Never
# committed: contents are content-addressed copies of DVC-tracked artefacts
# and would explode the repo. Push/pull via `dvc push|pull` instead.
.dvc-storage/

# Docker volumes
pgdata/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Local tool caches & dev-time screenshots (not referenced by any doc)
.playwright-mcp/
prg-*.png
