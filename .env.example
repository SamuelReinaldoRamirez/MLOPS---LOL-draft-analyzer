# ──────────────────────────────────────────
# LoL Draft Predictor — Environment Variables
# Copy to .env (`cp .env.example .env`) and edit locally.
# Placeholder values only — never commit real secrets.
# ──────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=lol_draft
POSTGRES_USER=lol_admin
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_PORT=5434

# Service ports (host)
STREAMLIT_PORT=8501
API_PORT=8000
# Next.js web UI (served by the `frontend` compose service).
FRONTEND_PORT=8080

# Comma-separated origins allowed to call the API from a browser (CORS).
# Includes the dockerised Next.js web UI (8080) and the local dev server (3000).
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:3000

# Base URL the BROWSER uses to reach the API. Baked into the web UI client
# bundle at build time (frontend build arg). Use the host-reachable URL, NOT
# the compose-internal http://api:8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# MLflow tracking server (Phase 2)
# Host port 5001 by default: 5000 conflicts with macOS AirPlay/ControlCenter.
MLFLOW_PORT=5001
MLFLOW_DB=mlflow
# Training logs to this URI; leave the compose default (http://mlflow:5000) for
# in-stack runs. Unset/blank -> training degrades to a NO-OP (no tracking).
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=lol-draft-timeline

# ──────────────────────────────────────────
# Monitoring (Phase 4) — Prometheus + Grafana
# ──────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Grafana admin credentials — placeholders only, set real values in local .env.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_local_env

# Drift / auto-retrain (Phase 4). Share of drifted columns above which a
# retrain is triggered. Used by scripts/auto_retrain.py + drift_report.py.
DRIFT_THRESHOLD=0.5

# ──────────────────────────────────────────
# Riot Games API (player-real-games feature)
# ──────────────────────────────────────────
# IN SCOPE for the player search / real-games feature. The key is used
# SERVER-SIDE ONLY by the API (app/riot_client.py for account-v1 + summoner-v4);
# it is never exposed to the browser. Leave blank here and set a real key in
# your local .env to enable live search — with no key the API returns a clear
# 503 and the UI shows a "Riot API key not configured" state.
RIOT_API_KEY=
# Default platform routing value used when a request omits ?region= (e.g.
# euw1, eun1, na1, kr, br1, jp1, oc1, tr1, la1, la2).
RIOT_PLATFORM=euw1
# Default regional cluster (americas | asia | europe | sea) for account-v1.
# Normally DERIVED from RIOT_PLATFORM by app/riot_client.regional_for_platform;
# kept here as documentation of the expected cluster for the default platform.
RIOT_REGION=europe
